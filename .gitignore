#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
devtools_options.yaml

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/key.properties
/android/app/*.jks
*.jks

# HarmonyOS: track ohos/ like android/ (AppScope, EntryAbility, module.json5, icons).
# Per-machine / generated paths are listed in ohos/.gitignore and ohos/entry/.gitignore
# (oh_modules, node_modules, build, .hvigor, flutter_assets, local.properties,
#  build-profile.json5 with DevEco signing secrets, GeneratedPluginRegistrant.ets).

# Local backups of old ohos/ trees (contain HAP / .so / kernel blobs — do not commit)
ohos.bak_legacy/
ohos.bak*/

# HarmonyOS / Flutter build artifacts that must never enter git
*.hap
*.hsp
kernel_blob.bin
isolate_snapshot_data
vm_snapshot_data

# HarmonyOS local overrides (copied from installers/HarmonyOS by pub-get.ps1)
pubspec_overrides.yaml

# Go relay service build outputs
relay/relayd
relay/relayd.exe
relay/dist/

# Local relayd runs used by the live tests
relay/relayd.live.*
# Regenerated by gen-l10n on every build; a report, not a source file.
lib/l10n/untranslated.json

