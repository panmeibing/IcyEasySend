# Copy to /etc/relayd/relayd.env and tighten permissions:
#   sudo install -d -m 0750 -o root -g relayd /etc/relayd
#   sudo install -m 0640 -o root -g relayd deploy/relayd.env.example /etc/relayd/relayd.env
#
# Generate a token with: openssl rand -base64 48

RELAY_LISTEN=:8443
RELAY_TOKEN=replace-me-with-at-least-32-characters
RELAY_MAX_CONCURRENT_STREAMS=8
RELAY_MAX_STREAM_BYTES=0
RELAY_RATE_LIMIT_BPS=0
RELAY_STREAM_RENDEZVOUS_TIMEOUT=30s
RELAY_STREAM_IDLE_TIMEOUT=60s
RELAY_PAIR_RATE_PER_MIN=5
RELAY_LOG_LEVEL=info

# Leave TLS empty when Caddy/Nginx terminates HTTPS in front of relayd.
# RELAY_TLS_CERT=/etc/relayd/fullchain.pem
# RELAY_TLS_KEY=/etc/relayd/privkey.pem
